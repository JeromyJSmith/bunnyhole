{
  "name": "bunnyhole",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.8.2",
      "@trpc/server": "^11.5.0",
      "better-auth": "^1.3.13",
      "dotenv": "^17.2.2",
      "zod": "^4.1.11",
      "typescript": "^5.8.2",
      "tsdown": "^0.15.5",
      "@trpc/client": "^11.5.0"
    }
  },
  "scripts": {
    "check": "biome check --write .",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @bunnyhole/db db:push",
    "db:studio": "turbo -F @bunnyhole/db db:studio",
    "db:generate": "turbo -F @bunnyhole/db db:generate",
    "db:migrate": "turbo -F @bunnyhole/db db:migrate"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.76",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "ai-sdk-tools": "^0.4.7",
    "dotenv": "^17.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "@biomejs/biome": "2.2.6",
    "ultracite": "5.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "tsdown": "^0.15.5",
    "@types/bun": "^1.2.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "packageManager": "bun@1.2.19",
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "ai-sdk-tools",
    "protobufjs"
  ]
}
